{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/johnbillion/plugin-infrastructure/schemas/github-actions-workflow.json",
    "title": "Opinionated GitHub Actions Workflow Schema",
    "description": "JSON schema for GitHub Actions workflows with opinionated security and best practice rules",
    "type": "object",
    "required": [
        "permissions",
        "jobs"
    ],
    "properties": {
        "permissions": {
            "type": "object",
            "description": "Workflow-level permissions are required for security"
        },
        "jobs": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_-]*$": {
                    "type": "object",
                    "required": [
                        "permissions",
                        "timeout-minutes"
                    ],
                    "properties": {
                        "permissions": {
                            "type": "object",
                            "description": "Job-level permissions are required for security"
                        },
                        "timeout-minutes": {
                            "type": "integer",
                            "description": "Job timeout is required to prevent runaway jobs"
                        }
                    }
                }
            }
        }
    }
}