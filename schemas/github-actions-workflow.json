{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/johnbillion/plugin-infrastructure/schemas/github-actions-workflow.json",
    "title": "Opinionated GitHub Actions Workflow Schema",
    "description": "JSON schema for GitHub Actions workflows with opinionated security and best practice rules",
    "type": "object",
    "required": [
        "permissions",
        "jobs"
    ],
    "properties": {
        "permissions": {
            "type": "object",
            "description": "Workflow-level permissions are required for security"
        },
        "on": {
            "type": "object"
        },
        "jobs": {
            "type": "object",
            "minProperties": 1
        }
    },
    "if": {
        "properties": {
            "on": {
                "properties": {
                    "workflow_call": true
                },
                "required": ["workflow_call"]
            }
        },
        "required": ["on"]
    },
    "then": {
        "properties": {
            "jobs": {
                "additionalProperties": {
                    "type": "object",
                    "required": [
                        "permissions"
                    ],
                    "properties": {
                        "permissions": {
                            "type": "object",
                            "description": "Job-level permissions are required for security"
                        }
                    }
                }
            }
        }
    },
    "else": {
        "properties": {
            "jobs": {
                "additionalProperties": {
                    "type": "object",
                    "required": [
                        "permissions",
                        "timeout-minutes"
                    ],
                    "properties": {
                        "permissions": {
                            "type": "object",
                            "description": "Job-level permissions are required for security"
                        },
                        "timeout-minutes": {
                            "type": "integer",
                            "description": "Job timeout is required to prevent runaway jobs"
                        }
                    }
                }
            }
        }
    }
}
