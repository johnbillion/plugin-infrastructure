#!/usr/bin/env bash

# Generates the production Composer autoloader into vendor/autoload.php and vendor/composer/ without
# installing any packages, so no third-party code runs.

set -euo pipefail

# Without installed.json Composer sees no installed packages, so none end up in the classmap:
echo 'ℹ️ Removing vendor/composer...'
rm -rf vendor/composer

echo 'ℹ️ Dumping non-dev autoloader...'
composer dump-autoload --no-dev --no-scripts --no-plugins

# Remove autoloading for `\Composer\InstalledVersions`:
static='vendor/composer/autoload_static.php'
needle='InstalledVersions'

# Without this, a needle that doesn't match would let the removal silently do nothing:
if [ "$(grep -cF -- "${needle}" "${static}")" -ne 1 ]; then
	echo "❌ Expected exactly one ${needle} line in ${static}"
	exit 1
fi

grep -vF -- "${needle}" "${static}" > "${static}.tmp"
mv "${static}.tmp" "${static}"

echo 'ℹ️ Removing files not needed for deployment...'
rm -f \
	vendor/composer/autoload_classmap.php \
	vendor/composer/autoload_files.php \
	vendor/composer/autoload_namespaces.php \
	vendor/composer/autoload_psr4.php \
	vendor/composer/installed.json \
	vendor/composer/installed.php \
	vendor/composer/InstalledVersions.php

if grep -qF 'InstalledVersions' vendor/autoload.php vendor/composer/*; then
	echo '❌ The autoloader still references InstalledVersions:'
	grep -nF 'InstalledVersions' vendor/autoload.php vendor/composer/*
	exit 1
fi

echo '✅ Vendor build complete. Run "composer install" to restore the development autoloader.'
