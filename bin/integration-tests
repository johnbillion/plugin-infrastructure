#!/usr/bin/env bash

# -e          Exit immediately if a pipeline returns a non-zero status
# -o pipefail Produce a failure return code if any command errors
set -eo pipefail

# Args
PLUGIN=${PWD##*/}
PHPUNIT_ARGS=$@

# Environment variables
export COMPOSE_PROJECT_NAME=${PLUGIN}

# Run the integration tests:
echo 'ℹ️ Running integration tests...'

# Why are these sent to /dev/null? See https://github.com/docker/compose/issues/8833
docker compose exec \
	--env COMPOSE_PROJECT_NAME \
	-T \
	--workdir "/var/www/html/wp-content/plugins/${PLUGIN}" php \
	./vendor/bin/phpunit --exclude-group ms-required ${PHPUNIT_ARGS} \
	< /dev/null

docker compose exec \
	--env COMPOSE_PROJECT_NAME \
	--env WP_MULTISITE=1 \
	-T \
	--workdir "/var/www/html/wp-content/plugins/${PLUGIN}" php \
	./vendor/bin/phpunit --exclude-group ms-excluded ${PHPUNIT_ARGS} \
	< /dev/null

echo '✅ Integration tests complete.'
