#!/usr/bin/env bash

# -e          Exit immediately if a pipeline returns a non-zero status
# -o pipefail Produce a failure return code if any command errors
set -eo pipefail

# Args
PLUGIN=${PWD##*/}

# Environment variables
export COMPOSE_PROJECT_NAME=${PLUGIN}

# Get the dynamic port number for a service:
get_service_port() {
	docker compose port "$1" "$2" | awk -F: '{print $2}'
}

# Prep:
WP_PORT=$(get_service_port server 80)
WP_URL="http://localhost:${WP_PORT}"

# Check if Playwright browsers are installed:
if ! npx playwright install --list 2>/dev/null | grep -q "chromium"; then
	echo 'ℹ️ Installing Playwright browsers...'
	npx playwright install chromium
fi

# Run the acceptance tests:
echo 'ℹ️ Running acceptance tests...'
WP_BASE_URL=$WP_URL \
	npx playwright test --config tests/acceptance/playwright.config.ts "$@"

echo '✅ Acceptance tests complete.'
