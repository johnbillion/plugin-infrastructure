{
	"name": "johnbillion/plugin-infrastructure",
	"description": "Reusable infrastructure relating to testing, building, and deploying my WordPress plugins",
	"license": "MIT",
	"type": "library",
	"authors": [
		{
			"name": "John Blackbourn",
			"homepage": "https://johnblackbourn.com/"
		}
	],
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/johnbillion"
		}
	],
	"require": {
		"php": ">=7.4",
		"roots/wordpress-core-installer": "1.100.0",
		"roots/wordpress-full": "*",
		"wp-phpunit/wp-phpunit": "*",
		"yoast/wp-test-utils": "1.2.0"
	},
	"require-dev": {
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"test": [
			"composer validate --strict --no-check-lock"
		]
	}
}
